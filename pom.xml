<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.maas</groupId>
        <artifactId>parent</artifactId>
        <version>2026.01</version>
    </parent>

    <groupId>nl.maas.framework</groupId>
    <version>2026.04-SNAPSHOT</version>
    <artifactId>easy-frameworks</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>easy-wicket-framework-lib</module>
        <module>easy-wicket-framework-test</module>
        <module>easy-io-framework-lib</module>
        <module>easy-torrent-framework-lib</module>
    </modules>

    <scm>
        <connection>
            scm:git:https://github.com/MichelMaas/easyframeworks.git
        </connection>

        <developerConnection>
            scm:git:ssh://git@github.com/MichelMaas/easyframeworks.git
        </developerConnection>

        <url>
            https://github.com/MichelMaas/easyframeworks
        </url>

        <tag>HEAD</tag>
    </scm>

    <properties>

    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>objectdb</id>
            <name>ObjectDB Repository</name>
            <url>https://m2.objectdb.com</url>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>maas-fam</id>
            <name>My local repo</name>
            <url>file:///shares/repo</url>
        </repository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>nl.maas.framework</groupId>
                <artifactId>easy-torrent-framework-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.maas.framework</groupId>
                <artifactId>easy-io-framework-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>nl.maas.framework</groupId>
                <artifactId>easy-wicket-framework-lib</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.hibernate</groupId>
                <artifactId>hibernate-jpamodelgen</artifactId>
                <version>${hibernate.version}</version>
            </dependency>

            <dependency>
                <groupId>com.objectdb</groupId>
                <artifactId>objectdb</artifactId>
                <version>2.8.6</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.persistence</groupId>
                <artifactId>javax.persistence</artifactId>
                <version>2.1.0</version>
            </dependency>
            <dependency>
                <groupId>javax.transaction</groupId>
                <artifactId>jta</artifactId>
                <version>1.1</version>
            </dependency>
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>1.6</version>
            </dependency>
        </dependencies>

    </dependencyManagement>


    <build>
        <pluginManagement>
            <plugins>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>

                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <goals>install</goals>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
